{
  "name": "giftcard-integration-template",
  "version": "0.4.0",
  "description": "Gift card integration template",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "node_modules/.bin/nodemon -q dist/main.js",
    "lint": "prettier --check \"**/**/*.{ts,js,json}\" && eslint src test",
    "lint:fix": "prettier --write \"**/**/*.{ts,js,json}\" && eslint --fix src test",
    "build": "rm -rf ./dist && tsc",
    "dev": "ts-node src/main.ts",
    "watch": "nodemon --watch \"src/**\" --ext \"ts,json,html\" --ignore \"src/**/*.spec.ts\" --exec \"ts-node src/main.ts\"",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch --detectOpenHandles",
    "test:coverage": "jest --detectOpenHandles --coverage",
    "connector:post-deploy": "node src/connectors/post-deploy.ts",
    "connector:pre-undeploy": "node src/connectors/pre-undeploy.ts"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@commercetools-backend/loggers": "27.9.6",
    "@commercetools/connect-payments-sdk": "1.2.2",
    "@fastify/autoload": "6.5.0",
    "@fastify/cors": "11.3.0",
    "@fastify/formbody": "9.0.0",
    "@fastify/http-proxy": "11.6.2",
    "@fastify/request-context": "7.0.0",
    "@fastify/static": "10.1.4",
    "@fastify/type-provider-typebox": "6.1.0",
    "@sinclair/typebox": "0.34.52",
    "dotenv": "17.4.2",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "qs": "6.16.0"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@3": "3.0.6",
    "brace-expansion@5": "5.0.9",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "fast-uri@3": "3.1.7",
    "fast-uri@4": "4.1.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "msw": "2.15.0",
    "node-fetch": "3.3.2",
    "nodemon": "3.1.14",
    "prettier": "3.9.8",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
