{
  "name": "enabler",
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "start": "serve public -l 8080 --cors",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check \"**/**/*.{ts,js,json}\"",
    "lint:fix": "prettier --write \"**/**/*.{ts,js,json}\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve": "npm run build && serve public -l 3000 --cors"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "sass": "1.105.1",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-css-injected-by-js": "5.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "serve": "14.2.6"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@3": "3.0.9",
    "brace-expansion@5": "5.0.12",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "fast-uri@3": "3.1.8"
  }
}
