{
  "name": "enabler",
  "version": "0.6.1",
  "type": "module",
  "engines": {
    "node": "^24.22.1",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "start": "serve public -l 8080 --cors",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check \"**/**/*.{ts,js,json}\"",
    "lint:fix": "prettier --write \"**/**/*.{ts,js,json}\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve": "npm run build && serve public -l 3000 --cors"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-css-injected-by-js": "5.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "serve": "14.2.6"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@3": "3.0.9",
    "brace-expansion@5": "5.0.12",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "fast-uri@3": "3.1.8",
    "compression": "1.8.2"
  }
}
